# Copy this file to server/.env and fill in the values from your Render
# PostgreSQL dashboard (Dashboard → your database → Connections).
# server/.env is git-ignored, so the real password never gets committed.

PGUSER=your_render_username
PGPASSWORD=your_render_password
PGHOST=dpg-xxxxxxxxxxxxxxxxxxxx-a.oregon-postgres.render.com
PGPORT=5432
PGDATABASE=your_render_database_name
